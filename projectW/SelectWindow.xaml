<AduSkin:MetroWindow x:Class="projectW.SelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projectW"
       xmlns:AduSkin="clr-namespace:AduSkin.Controls.Metro;assembly=AduSkin" 
                  
        Closed="Window_Closed"
        mc:Ignorable="d"
          Title="车辆停放模拟系统" Height="600" Width="1000" Icon="/W.ico" FontSize="24" Background="#222272" 
  ResizeMode="NoResize" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Grid  Grid.Row="1" >
            <AduSkin:MetroTextBlock Text="选择你想要执行的操作" Foreground="#00abff" 
             HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40"/>
        </Grid>
        <Grid  Grid.Row="2" >
            <AduSkin:MetroButton Content="直接生成停车记录" Foreground="#ffffff"
        HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" Width="400" Height="80"
                                 Click="MetroButton_Click">
                <AduSkin:MetroButton.Background>
                    <ImageBrush ImageSource="/Resources/AfterImage.png"/>
                </AduSkin:MetroButton.Background>
            </AduSkin:MetroButton>
        </Grid>
        <Grid  Grid.Row="3" >
            <AduSkin:MetroButton Content="进行停入取出操作" Foreground="#ffffff"
        HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" Width="400" Height="80"
                                 Click="MetroButton_Click2">
                <AduSkin:MetroButton.Background>
                    <ImageBrush ImageSource="/Resources/AfterImage2.png"/>
                </AduSkin:MetroButton.Background>
            </AduSkin:MetroButton>
        </Grid>
    </Grid>
</AduSkin:MetroWindow>
