<AduSkin:MetroWindow x:Class="projectW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:AduSkin="clr-namespace:AduSkin.Controls.Metro;assembly=AduSkin" 
        xmlns:local="clr-namespace:projectW"
        mc:Ignorable="d"
        Title="车辆停放模拟系统" Height="600" Width="1000" Icon="/W.ico" FontSize="24" Background="#87CEEB" 
        ResizeMode="NoResize" >

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/W.png" Opacity="0.4" Stretch="Uniform" />
        </Grid.Background>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <TextBlock FontStyle="Italic" FontSize="30">
                <TextBlock.Text>W Company</TextBlock.Text>
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#4169E1"/>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>


            <Grid Grid.Column="1">
                <Border BorderThickness="1" BorderBrush="Gray"  CornerRadius="25,25,25,25">
                    <Border.Background>
                        <SolidColorBrush Color="#1E90FF" Opacity="0.6"/>
                    </Border.Background>
                    <AduSkin:AduStepBar x:Name="stepBar"  ItemsSource="{Binding StepItems}" Progress="{Binding StepIndex,Mode=TwoWay}"  FontStyle="Oblique"/>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <ContentControl x:Name="tab" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <AduSkin:MetroButton Margin="15,2" Click="PreButton_Click" IsEnabled="{Binding IsPreviousEnabled}">
                        <AduSkin:MetroButton.Background>
                            <SolidColorBrush Color="#CC4E5C" />
                        </AduSkin:MetroButton.Background>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Resources/up.png" Width="64" Height="64" Margin="0,0,20,0"/>
                            <TextBlock Text="上一步" VerticalAlignment="Center" FontSize="34"  Foreground="#1EAAFF"/>
                        </StackPanel>
                    </AduSkin:MetroButton>


                </Grid>
                <Grid Grid.Column="1">
                    <AduSkin:MetroButton Margin="15,2" Click="nextButton_Click" IsEnabled="{Binding IsNextEnabled}"> 
                        <AduSkin:MetroButton.Background>
                            <SolidColorBrush Color="#338820"/>
                        </AduSkin:MetroButton.Background>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="下一步" VerticalAlignment="Center" FontSize="34"  Foreground="#1EFFFF"/>
                            <Image Source="/Resources/down.png" Width="64" Height="64" Margin="20,0,0,0"/>                   
                        </StackPanel>
                    </AduSkin:MetroButton>

                </Grid>

            </Grid>
        </Grid>
    </Grid>
</AduSkin:MetroWindow>
