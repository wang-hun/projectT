<UserControl x:Class="projectW.tab.InTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:projectW.tab"
               xmlns:AduSkin="clr-namespace:AduSkin.Controls.Metro;assembly=AduSkin" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--" DataContext="InOutWindow"-->
    <Grid >
        <Grid.Background>
            <SolidColorBrush Color="#00FF7F" Opacity="0.6"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" >
                <TextBlock Text="选择车辆" VerticalAlignment="Center" FontSize="34" HorizontalAlignment="Center" Foreground="#ffffff"/>
                <ComboBox ItemsSource="{Binding CarnumbersIn}"  x:Name="comboBox1" 
                   SelectedItem="{Binding CarNumberIn,Mode=TwoWay}" IsTextSearchEnabled="True" IsEditable="True"/>
                <TextBlock Text="选择停车场" VerticalAlignment="Center" FontSize="34" HorizontalAlignment="Center" Foreground="#ffffff"/>
                <ComboBox ItemsSource="{Binding ParksIn}"  x:Name="comboBox2" 
    SelectedItem="{Binding ParkIn,Mode=TwoWay}" IsTextSearchEnabled="True" IsEditable="True"/>
                <AduSkin:MetroButton Margin="0,20,0,0" Content="生成停入记录" Foreground="#ffffff" Click="MetroButton_Click"> 
                    <AduSkin:MetroButton.Background>
                        <ImageBrush ImageSource="/Resources/AfterImage2.png" Stretch="Uniform" />
                    </AduSkin:MetroButton.Background>
                </AduSkin:MetroButton>
            </StackPanel>

        </Grid>
        <Grid Grid.Column="2">

            <AduSkin:MetroButton Click="ReNew" >
                <AduSkin:MetroButton.Background>
                    <SolidColorBrush Color="#00FF7F" Opacity="0.6"/>
                </AduSkin:MetroButton.Background>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <Image Source="/Resources/renew.png" Stretch="Uniform"/>
                    <TextBlock Text="刷新" VerticalAlignment="Center" FontSize="34" HorizontalAlignment="Center" Foreground="#000000"/>
                </StackPanel>
            </AduSkin:MetroButton>
        </Grid>
    </Grid>
</UserControl>
