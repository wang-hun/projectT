<UserControl x:Class="projectW.tab.UserControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:projectW.tab"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="100,5,100,5">
        <Grid.Background>
            <SolidColorBrush Color="#7FFFD4" Opacity="0.6"/>
        </Grid.Background>
        <TextBlock Text="2" FontSize="34"/>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="选择要停放的位置" FontSize="30" Foreground="Blue" HorizontalAlignment="Center"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="20*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ParkNames}" x:Name="combo"
             SelectedItem="{Binding ParkName,Mode=TwoWay}" IsTextSearchEnabled="True" IsEditable="True" >

                </ComboBox>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
