<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:projectW.tab"
             xmlns:adu="https://github.com/aduskin" x:Class="projectW.tab.UserControl4"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="100,5,100,5">
        <Grid.Background>
            <SolidColorBrush Color="#80CDCD" Opacity="0.6"/>
        </Grid.Background>
        <TextBlock Text="4" FontSize="34"/>
        <StackPanel VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="车牌号:" HorizontalAlignment="Right" FontSize="26" Foreground="#0008b0" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="1" Text="{Binding CarNumber}" HorizontalAlignment="Left" FontSize="26" Foreground="#7400a1"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="停放位置:" HorizontalAlignment="Right" FontSize="26" Foreground="#0008b0" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ParkName}" HorizontalAlignment="Left" FontSize="26" Foreground="#7400a1"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="开始时间:" HorizontalAlignment="Right" FontSize="26" Foreground="#0008b0" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="1" Text="{Binding StartTime, StringFormat=\{0:yyyy年MM月dd日 HH:mm:ss\}}" HorizontalAlignment="Left" FontSize="26" Foreground="#7400a1"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="结束时间:" HorizontalAlignment="Right" FontSize="26" Foreground="#0008b0" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="1" Text="{Binding EndTime , StringFormat=\{0:yyyy年MM月dd日 HH:mm:ss\}}" HorizontalAlignment="Left" FontSize="26" Foreground="#7400a1"/>
            </Grid>
            <adu:MetroButton Content="生成停车记录" HorizontalAlignment="Center" Margin="0,20,0,20" VerticalAlignment="Top" Click="MetroButton_Click"/>
            <Grid/>
        </StackPanel>
      
    </Grid>
</UserControl>
